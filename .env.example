# ────────────────────────────────────────────────────────────────
#  Элиан / Elian — пример конфигурации.
#  Скопируйте в $HOME/.elian/elian.env (chmod 600) — bootstrap делает это сам.
#  Секреты здесь НЕ храните: ключи лежат в SECRETS_DIR отдельными файлами.
# ────────────────────────────────────────────────────────────────

# Окружение: production | development | test
NODE_ENV=production

# Слушать только локально. 0.0.0.0 включайте осознанно (доступ из локальной сети).
HOST=127.0.0.1
PORT=3000

# Публичный домен (замените на свой при именованном туннеле)
PUBLIC_DOMAIN=PUBLIC_DOMAIN
PUBLIC_URL=https://PUBLIC_DOMAIN
# Дополнительные разрешённые Origin (через запятую), если клиент открывают не с публичного домена
ALLOWED_ORIGINS=

# Каталоги (вне репозитория!)
DATA_DIR=~/.elian/data
MEDIA_DIR=~/.elian/data/media
LOG_DIR=~/.elian/logs
BACKUP_DIR=~/.elian/backups
SECRETS_DIR=~/.elian/secrets
WEB_DIST_DIR=./apps/web/dist

# Шифрование базы: required (SQLCipher) | off (только для отладки, НЕ для продакшена)
DB_ENCRYPTION=required

# Параметры Argon2id. Значения подобраны под смартфон; не ослабляйте ниже.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Сессии
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=elian_session
CSRF_COOKIE_NAME=elian_csrf

# Консоль владельца и уведомления
OWNER_CONSOLE=true
# Показывать код подтверждения в уведомлении Termux (риск: виден на экране блокировки)
OWNER_NOTIFICATION_SHOW_CODE=true
TERMUX_NOTIFICATIONS=true
PENDING_TTL_MINUTES=5
REQUIRE_OWNER_APPROVAL=true
REGISTRATION_ENABLED=true

# Доверять IP только из заголовков Cloudflare (иначе X-Forwarded-For игнорируется)
TRUST_CLOUDFLARE_PROXY=true

# Лимиты
MEDIA_MAX_BYTES=104857600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FACTOR=1
LOG_LEVEL=info

# Web Push (генерируется автоматически, если пусто)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@PUBLIC_DOMAIN

# TURN для звонков (необязательно; без него звонки работают не во всех сетях)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Туннель: quick | named | none
ELIAN_TUNNEL_MODE=quick

# Поиск GIF (внешний сервис, необязательно)
GIF_PROVIDER_URL=
GIF_PROVIDER_KEY=

# Демо-данные при первом запуске (только для разработки)
SEED_DEMO=false
